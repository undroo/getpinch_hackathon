# Local Docker: postgresql://postgres:postgres@localhost:54322/postgres
# Supabase (transaction pooler): postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Pinch sandbox OAuth (Developer Portal → API Keys)
PINCH_MERCHANT_ID=
PINCH_API_KEY=
PINCH_PUBLISHABLE_KEY=
PINCH_BASE_URL=https://api.getpinch.com.au/test
PINCH_WEBHOOK_SECRET=
# Optional — preserve real sandbox IDs across re-seeds (filled by setup_pinch_sandbox.py)
PINCH_STANDARD_PLAN_ID=
PINCH_HOLD_PLAN_ID=
PINCH_PAYER_SARAH=
PINCH_PAYER_MARCUS=
PINCH_PAYER_AVERY=
CORS_ORIGINS=http://localhost:3000
DEMO_GYM_NAME=GymPlus
WEB_APP_URL=http://localhost:3000
